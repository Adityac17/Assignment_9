# ---- Pharmacy & Healthcare Store API — environment variables ----

# MongoDB Atlas connection string (see README "Database Setup").
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmacy?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret

# How long issued tokens stay valid (optional, defaults to 7d).
JWT_EXPIRES_IN=7d

# Shared secret required to create pharmacist/admin accounts via /api/auth/register-staff.
ADMIN_SECRET_KEY=super_secret_admin_key

# Port Express listens on (optional, defaults to 5000).
PORT=5000
